# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real keys.

# Supabase project settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Service role key — server-only, never expose to the browser. Same page in Supabase settings.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Admin area (/admin) — gates adding/editing boards and products.
# Pick your own passcode and a long random secret (e.g. `openssl rand -hex 32`).
ADMIN_PASSCODE=choose-a-passcode
ADMIN_SESSION_SECRET=a-long-random-string

# Real deployed domain — used to build absolute URLs in robots.txt/sitemap.xml.
NEXT_PUBLIC_SITE_URL=https://your-domain.com
